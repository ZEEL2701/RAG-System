# --- Neon (recommended): paste the pooled connection string from the Neon dashboard ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Or use individual DB vars (local Postgres) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ragdb
# DB_USER=postgres
# DB_PASSWORD=your_password

# Embeddings (runs in-process on Render; no Ollama server required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434

# Groq LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_COMPLETION_MAX_TOKENS=512
MAX_TOKENS=256

# RAG tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=50
COLLECTION_NAME=rag-pgvector
MAX_CONTEXT_DOCUMENTS=3
SEARCH_K=5
MAX_CHARS_PER_CONTEXT_DOC=900

# Production (Render sets PORT automatically)
# GRADIO_SERVER_NAME=0.0.0.0
# GRADIO_SHARE=false
# PORT=7860

# Optional S3 for durable uploads on Render (local disk is ephemeral)
# S3_ENABLED=true
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
